{
  "expo": {
    "name": "Mes moyennes",
    "slug": "mes-moyennes-perso",
    "version": "3.4.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.mesmoyennes.perso"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "fr.mesmoyennes.perso"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Mes moyennes",
      "shortName": "Moyennes",
      "lang": "fr"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
